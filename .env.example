# Backend API
BACKEND_URL=http://localhost:4004

# NextAuth
NEXTAUTH_SECRET=change-me-min-32-chars
NEXTAUTH_URL=http://localhost:4003

# GitHub OAuth App used for "Sign in with GitHub" (NextAuth provider)
# Authorization callback URL must be: {NEXTAUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
