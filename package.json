{
  "name": "tocktest-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-heroui-css": "node scripts/copy-heroui-css.mjs",
    "postinstall": "node scripts/copy-heroui-css.mjs",
    "predev": "node scripts/copy-heroui-css.mjs",
    "prebuild": "node scripts/copy-heroui-css.mjs",
    "dev": "next dev -p 4003",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 4003",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 3012",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.475.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.11",
    "next-intl": "^4.13.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next-auth": {
      "uuid": "^11.1.1"
    },
    "sharp": "^0.35.3",
    "postcss": "$postcss",
    "react-aria-components": "1.19.0"
  }
}
